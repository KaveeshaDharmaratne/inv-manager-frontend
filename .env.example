# App mode
VITE_APP_MODE=demo
VITE_APP_NAME=Inventory Manager Demo
VITE_APP_SUBTITLE=Explore inventory workflows using sample data

# Backend API
VITE_API_URL=http://localhost:3000

# Firebase web configuration
VITE_FIREBASE_API_KEY=your_demo_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_demo_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_demo_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_demo_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_demo_sender_id
VITE_FIREBASE_APP_ID=your_demo_app_id

# Production-only email allow-list
VITE_AUTHORIZED_EMAILS=

# Invoice/demo branding
VITE_BUSINESS_NAME=Demo Distribution (Pvt) Ltd
VITE_BUSINESS_ADDRESS=123 Lake Road, Colombo
VITE_BUSINESS_PHONE=+94 11 000 0000
VITE_BUSINESS_EMAIL=demo@example.com
VITE_AUTHORIZED_FOR_NAME=Demo Manufacturing Group
VITE_AUTHORIZED_FOR_ADDRESS=Colombo, Sri Lanka
